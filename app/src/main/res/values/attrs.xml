<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Background for the informational panes (engine evaluation, move history,
        last move, ECO, game rows). A theme attribute rather than a direct colour
        reference so e-ink mode can swap the translucent tint for an outline.
    -->
    <attr name="paneBackground" format="reference|color" />

    <!--
        Image-button style as a theme attribute, so e-ink can swap in a flat
        outlined variant without touching every layout.

        There is deliberately no chessButtonStyle twin. Text buttons referencing
        one via style="?attr/..." rendered black on black in e-ink mode even when
        the referenced style was colour-identical to this one; they take the
        theme's materialButtonStyle instead, which is observed to work.
    -->
    <attr name="chessImageButtonStyle" format="reference" />
</resources>
