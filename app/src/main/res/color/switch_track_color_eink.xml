<?xml version="1.0" encoding="utf-8"?>
<!--
    Switch track for e-ink. Material fills the track with the secondary colour
    when checked, giving a green bar. A single flat grey, matching the dark board
    square, reads cleanly in both states; the thumb carries on/off.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/einkSurface" />
    <item android:color="@color/einkBoardDark" />
</selector>
