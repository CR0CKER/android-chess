<?xml version="1.0" encoding="utf-8"?>
<!--
    Switch thumb for e-ink. Black when on, white when off, both against the grey
    track: maximum contrast at either end, and no reliance on hue.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/einkSurface" />
    <item android:state_checked="true" android:color="@color/einkForeground" />
    <item android:color="@color/einkBackground" />
</selector>
