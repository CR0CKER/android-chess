<?xml version="1.0" encoding="utf-8"?>
<!--
    Switch thumb for e-ink. The stock list uses primaryColor when checked, which
    is a blue dot on a greyscale panel. State is carried by thumb position and
    darkness instead of hue.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/einkSurface" />
    <item android:state_checked="true" android:color="@color/einkForeground" />
    <item android:color="@color/einkMidtone" />
</selector>
